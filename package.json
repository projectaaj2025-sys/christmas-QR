{
  "name": "christmas-qr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Turn any link into a Christmas tree that is also a scannable QR code.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/build-embed.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "verify": "node scripts/verify-scan.mjs && node scripts/verify-embed.mjs && node scripts/verify-receive.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
